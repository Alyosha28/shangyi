{
  "name": "dsh-plugin-shangyi",
  "version": "0.2.0",
  "private": true,
  "description": "商奕（ShangYi）领域卡片：在 DSH Web GUI 会话头部展示真实案例的支付矩阵 / 均衡分布 / 工具失败原文（读 case.log 投影）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}