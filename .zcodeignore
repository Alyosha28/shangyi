# 密钥与凭据 —— 绝不提交
*.env
.env
**/secrets/
~/.shangyi-secrets/

# 系统附属文件（外接盘生成的 ._ 前缀文件）
._*

# 构建产物
target/
vendor/**/target/
**/*.rs.bk

# Python 侧车
.venv/
__pycache__/
*.pyc

# 运行期产物
.shangyi-loop/snapshots/
.shangyi-loop/runs/*.tmp

# macOS
.DS_Store

# 依赖树（体积大、可重建）
node_modules/
**/node_modules/

# git 目录迁移备份（迁移验证完成后可手工删除）
.git.mountbak/

# 本机盘上的 git 目录（供参考，不参与版本控制）

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
